VITE_API_BASE_URL="http://localhost:4000/api"
VITE_DEFAULT_TENANT_SLUG="acme"
# Base domain tenant subdomains are matched against (acme.<this> -> tenant "acme").
# Use "localhost" for local dev (modern browsers resolve *.localhost to 127.0.0.1
# automatically, no /etc/hosts edits needed); set to the real base domain (e.g.
# "hrmplus.test" or your production domain) elsewhere. Must match the backend's
# PUBLIC_TENANT_BASE_DOMAIN.
VITE_PUBLIC_TENANT_BASE_DOMAIN="localhost"
