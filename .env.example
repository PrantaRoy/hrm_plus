# Used by docker-compose.yml:  cp .env.example .env && docker compose up --build
# Every value has a working local default; CHANGE ALL SECRETS for any non-local deployment.

# --- MySQL ---
# Keep it alphanumeric: it is embedded in mysql:// connection URLs without URL-encoding.
MYSQL_ROOT_PASSWORD=hrmplusdev
# Host port for connecting with a DB client (3307 avoids clashing with a local MySQL on 3306).
MYSQL_HOST_PORT=3307

# --- Redis ---
# Host port for running the API on your own machine against Redis in Docker (localhost only).
REDIS_HOST_PORT=6379

# --- Auth / crypto ---
JWT_ACCESS_SECRET=change-me-dev-secret
JWT_REFRESH_SECRET=change-me-dev-refresh-secret
JWT_SAAS_ACCESS_SECRET=change-me-dev-saas-secret
# Min 32 chars. Encrypts tenant-configured secrets (e.g. AI API keys) at rest.
SETTINGS_ENCRYPTION_KEY=change-me-dev-settings-encryption-key-32chars-min

# --- Demo data ---
# Seeds the SaaS admin (saas@hrmplus.test / 1234abcd), the "acme" tenant (acme@hrmplus.test / 1234abcd)
# and sample packages. Idempotent. Set to false for anything public.
SEED_DEMO=true

# --- URLs / domains (change these together — for a bare IP deployment, use that IP; for a real
# domain, change these together with PUBLIC_TENANT_BASE_DOMAIN / VITE_PUBLIC_TENANT_BASE_DOMAIN above) ---
# Allowed browser origins for the API (tenant app + SaaS app).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Base URL of the tenant app, used in emails (password reset etc.).
FRONTEND_BASE_URL=http://localhost:5173
# Tenant subdomains match <slug>.<this> (acme.localhost -> tenant "acme").
PUBLIC_TENANT_BASE_DOMAIN=localhost

# --- Frontend build-time values (baked into the bundles; changing them needs `docker compose up --build`) ---
# These are URLs the BROWSER uses to reach the API, so they must be host-reachable, not docker-internal.
# Deploying to a bare EC2 IP with no domain (e.g. an academic demo)? Replace localhost with that IP,
# e.g. VITE_API_BASE_URL=http://3.25.111.22:4000/api — see docs/DEPLOY_AWS.md.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SAAS_API_BASE_URL=http://localhost:4000
VITE_DEFAULT_TENANT_SLUG=acme
VITE_PUBLIC_TENANT_BASE_DOMAIN=localhost

# --- Email (leave SMTP_HOST empty to use an auto-created Ethereal test inbox; preview links are logged) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HRM PLUS <no-reply@hrmplus.test>

# --- File storage: "local" (docker volume `uploads`) or "s3" ---
STORAGE_DRIVER=local
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# --- LLM fallback (used only when a tenant hasn't set its own key in Settings > AI) ---
LLM_PROVIDER=groq
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
