# Control-plane database (tenant registry)
CONTROL_DATABASE_URL="mysql://root@localhost:3306/hrm_control"

# Used only when authoring tenant migrations (prisma migrate dev --schema=prisma/tenant/schema.prisma).
# Points at a scratch/template database, never a real tenant's data.
TENANT_MIGRATION_DATABASE_URL="mysql://root@localhost:3306/hrm_tenant_template"

# Base connection info used to build each tenant's DATABASE_URL at runtime (host/port/credentials only;
# the database name itself comes from Tenant.databaseName in the control DB).
TENANT_DB_HOST="localhost"
TENANT_DB_PORT="3306"
TENANT_DB_USER="root"
TENANT_DB_PASSWORD=""

JWT_ACCESS_SECRET="change-me-dev-secret"
JWT_ACCESS_TTL="30m"
JWT_REFRESH_SECRET="change-me-dev-refresh-secret"
JWT_REFRESH_TTL="7d"

# Separate secret for the SaaS super-admin portal, so a tenant token can never be mistaken for an admin token.
JWT_SAAS_ACCESS_SECRET="change-me-dev-saas-secret"
JWT_SAAS_ACCESS_TTL="30m"

PORT="4000"
NODE_ENV="development"
# Comma-separated list of allowed frontend origins (tenant app + saas app).
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Used to build the login URL shown in the "approved" email, e.g. https://acme.hrmplus.test
PUBLIC_TENANT_BASE_DOMAIN="hrmplus.test"

# Base URL of the frontend app, used to build links in emails (e.g. password reset).
FRONTEND_BASE_URL="http://localhost:5173"

# SMTP for outbound email (pending/approved notifications). Leave SMTP_HOST unset to use an
# auto-created Ethereal test inbox instead (preview links are logged) - no real credentials needed for local dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="HRM PLUS <no-reply@hrmplus.test>"

# How long a candidate's magic-link portal/assessment token stays valid (multi-use until then).
CANDIDATE_PORTAL_TOKEN_TTL_HOURS="168"
# How close to the pass threshold (in percentage points) a score must land to be flagged
# PASSED_PENDING_REVIEW instead of an outright PASSED/FAILED.
ASSESSMENT_BORDERLINE_BAND_PERCENT="10"

# Redis connection used by BullMQ for the async short-text assessment grading queue.
REDIS_URL="redis://localhost:6379"
ASSESSMENT_GRADING_CONCURRENCY="5"

# LLM provider for "Generate with AI" assessment questions + short-text grading.
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
