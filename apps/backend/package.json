{
  "name": "@hrm-plus/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run prisma:generate",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "lint": "eslint src --ext .ts",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate --schema=prisma/control/schema.prisma && prisma generate --schema=prisma/tenant/schema.prisma",
    "migrate:control": "prisma migrate dev --schema=prisma/control/schema.prisma",
    "migrate:control:deploy": "prisma migrate deploy --schema=prisma/control/schema.prisma",
    "migrate:tenant:dev": "prisma migrate dev --schema=prisma/tenant/schema.prisma",
    "provision-tenant": "tsx scripts/provision-tenant.ts"
  },
  "dependencies": {
    "@hrm-plus/shared": "*",
    "@prisma/client": "^5.20.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "nanoid": "^3.3.7",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
