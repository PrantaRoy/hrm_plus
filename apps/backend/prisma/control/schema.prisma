generator client {
  provider = "prisma-client-js"
  output   = "../../generated/control"
}

datasource db {
  provider = "mysql"
  url      = env("CONTROL_DATABASE_URL")
}

model Tenant {
  id                Int                @id @default(autoincrement())
  name              String
  slug              String             @unique
  databaseName      String             @unique
  status            String             @default("Active")
  packageId         Int?
  package           Package?           @relation(fields: [packageId], references: [id])
  applicationId     Int?               @unique
  application       TenantApplication? @relation(fields: [applicationId], references: [id])
  companyType       String?
  overview          String?            @db.Text
  numberOfEmployees Int?
  companyLogoUrl    String?
  contactEmail      String?
  startDate         DateTime           @default(now())
  endDate           DateTime?
  createdAt         DateTime           @default(now())
  tickets           SupportTicket[]
}

model PlatformAdmin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Package {
  id           Int                  @id @default(autoincrement())
  name         String
  price        Decimal              @default(0) @db.Decimal(10, 2)
  validityDays Int?
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  applications TenantApplication[]
  tenants      Tenant[]
}

model TenantApplication {
  id                Int       @id @default(autoincrement())
  companyName       String
  companyLogoUrl    String?
  companyType       String
  overview          String    @db.Text
  numberOfEmployees Int
  contactEmail      String
  subdomainSlug     String    @unique
  packageId         Int
  package           Package   @relation(fields: [packageId], references: [id])
  status            String    @default("Pending")
  reviewNote        String?   @db.Text
  submittedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  tenant            Tenant?
}

model SupportTicketCategory {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  isDefault Boolean         @default(false)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  tickets   SupportTicket[]
}

model SupportTicket {
  id                Int                    @id @default(autoincrement())
  tenantId          Int
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  categoryId        Int
  category          SupportTicketCategory  @relation(fields: [categoryId], references: [id])
  subject           String
  message           String                 @db.Text
  status            String                 @default("Pending")
  priority          String?
  attachmentFileUrl String?
  attachmentFileKey String?
  createdByUserId   Int
  createdByName     String
  createdByEmail    String
  closedAt          DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  replies           SupportTicketReply[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([status])
}

model SupportTicketReply {
  id                Int           @id @default(autoincrement())
  ticketId          Int
  ticket            SupportTicket @relation(fields: [ticketId], references: [id])
  authorType        String
  authorId          Int
  authorName        String
  authorEmail       String
  message           String        @db.Text
  attachmentFileUrl String?
  attachmentFileKey String?
  createdAt         DateTime      @default(now())

  @@index([ticketId])
}
