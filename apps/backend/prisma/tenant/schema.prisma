generator client {
  provider = "prisma-client-js"
  output   = "../../generated/tenant"
}

datasource db {
  provider = "mysql"
  url      = env("TENANT_MIGRATION_DATABASE_URL")
}

model Role {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  status           String   @default("Active")
  shortDescription String?
  users            User[]
  leaveApprovalSteps LeaveApprovalStep[]
  documentTemplateApprovalSteps DocumentTemplateApprovalStep[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id                 Int        @id @default(autoincrement())
  email              String     @unique
  passwordHash       String
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  roleId             Int
  role         Role       @relation(fields: [roleId], references: [id])
  employee     Employee?
  auditLogs    AuditLog[]
  rostersGenerated   Roster[]                 @relation("RosterGeneratedBy")
  rostersApproved    Roster[]                 @relation("RosterApprovedBy")
  rostersCreated     Roster[]                 @relation("RosterCreatedBy")
  rostersUpdated     Roster[]                 @relation("RosterUpdatedBy")
  assignmentsCreated DutyScheduleAssignment[] @relation("AssignmentCreatedBy")
  assignmentsUpdated DutyScheduleAssignment[] @relation("AssignmentUpdatedBy")
  passwordResetTokens PasswordResetToken[]
  leaveAllocationsCreated EmployeeLeaveAllocation[] @relation("LeaveAllocationCreatedBy")
  leaveAllocationsUpdated EmployeeLeaveAllocation[] @relation("LeaveAllocationUpdatedBy")
  leaveRequestsCreated    LeaveRequest[]            @relation("LeaveRequestCreatedBy")
  leaveRequestsUpdated    LeaveRequest[]            @relation("LeaveRequestUpdatedBy")
  leaveApprovalsDecided   LeaveRequestApproval[]    @relation("LeaveApprovalDecidedBy")
  attendanceSettingsUpdated AttendanceSettings[]    @relation("AttendanceSettingsUpdatedBy")
  generalSettingsUpdated    GeneralSettings[]       @relation("GeneralSettingsUpdatedBy")
  attendanceDevicesApproved EmployeeAttendanceDevice[] @relation("AttendanceDeviceApprovedBy")
  attendanceManualEntries   Attendance[]               @relation("AttendanceManualEntryBy")
  holidaysCreated    Holiday[]                @relation("HolidayCreatedBy")
  holidaysUpdated    Holiday[]                @relation("HolidayUpdatedBy")
  holidaysPublished  Holiday[]                @relation("HolidayPublishedBy")
  documentTemplatesCreated DocumentTemplate[]       @relation("DocumentTemplateCreatedBy")
  documentTemplatesUpdated DocumentTemplate[]       @relation("DocumentTemplateUpdatedBy")
  documentRequestsCreated  DocumentRequest[]        @relation("DocumentRequestCreatedBy")
  documentRequestsUpdated  DocumentRequest[]        @relation("DocumentRequestUpdatedBy")
  documentApprovalsDecided DocumentRequestApproval[] @relation("DocumentApprovalDecidedBy")
  signatureImageUrl  String?
  signatureImageKey  String?
  signatureUpdatedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Department {
  id                 Int          @id @default(autoincrement())
  name               String
  status             String       @default("Active")
  shortDescription   String?
  parentDepartmentId Int?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[] @relation("DepartmentHierarchy")
  employees          Employee[]
  rosters            Roster[]
  dutyAssignments    DutyScheduleAssignment[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Shift {
  id        Int      @id @default(autoincrement())
  name      String
  startTime String
  endTime   String
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeekDay {
  id        Int      @id @default(autoincrement())
  name      String
  isWeekend Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveType {
  id           Int      @id @default(autoincrement())
  name         String
  assignedDays Int
  status       String   @default("Active")
  allocations  EmployeeLeaveAllocation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Designation {
  id               Int        @id @default(autoincrement())
  name             String
  status           String     @default("Active")
  shortDescription String?
  employees        Employee[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Employee {
  id              Int          @id @default(autoincrement())
  employeeCode    String       @unique
  firstName       String
  lastName        String
  email           String       @unique
  phoneNumber     String?
  gender          String?
  dateOfBirth     DateTime?
  jobTitle        String?
  status          String       @default("Active")
  joiningDate     DateTime
  terminationDate DateTime?
  employmentType  String       @default("Full-Time")
  avatarUrl       String?
  avatarKey       String?
  departmentId    Int?
  department      Department?  @relation(fields: [departmentId], references: [id])
  designationId   Int?
  designation     Designation? @relation(fields: [designationId], references: [id])
  reportingToId   Int?
  reportingTo     Employee?    @relation("EmployeeHierarchy", fields: [reportingToId], references: [id])
  directReports   Employee[]   @relation("EmployeeHierarchy")
  userId          Int?         @unique
  user            User?        @relation(fields: [userId], references: [id])
  documents       EmployeeDocument[]
  dutyAssignments DutyScheduleAssignment[]
  leaveAllocations EmployeeLeaveAllocation[]
  leaveRequests    LeaveRequest[]
  attendances         Attendance[]
  attendanceMethods   EmployeeAttendanceMethod[]
  attendanceIpRules     EmployeeAttendanceIpRule[]
  attendanceLocations   EmployeeAttendanceLocation[]
  attendanceDevices     EmployeeAttendanceDevice[]
  attendanceRules       EmployeeAttendanceRules?
  documentRequests      DocumentRequest[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model EmployeeDocument {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id])
  documentName    String
  type            String
  startDate       DateTime?
  expiryDate      DateTime?
  documentFileUrl String?
  documentFileKey String?
  status          String    @default("Active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   Int?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model DutySchedule {
  id                        Int      @id @default(autoincrement())
  name                      String
  startTime                 String
  endTime                   String
  checkinConsiderMinutes    Int      @default(0)
  checkoutConsiderMinutes   Int      @default(0)
  maxOverTimeMinutes        Int      @default(0)
  earlyCheckinBufferMinutes Int      @default(0)
  isTardyApplicable         Boolean  @default(true)
  status                    String   @default("Active")
  shortDescription          String?
  assignments               DutyScheduleAssignment[]
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Roster {
  id            Int       @id @default(autoincrement())
  departmentId  Int
  department    Department @relation(fields: [departmentId], references: [id])
  periodType    String    // "Weekly" | "Fortnightly" | "Monthly"
  startDate     DateTime
  endDate       DateTime
  status        String    @default("Draft") // "Draft" | "Pending" | "Approved"
  generatedById Int?
  generatedBy   User?     @relation("RosterGeneratedBy", fields: [generatedById], references: [id])
  approvedById  Int?
  approvedBy    User?     @relation("RosterApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  createdById   Int
  createdBy     User      @relation("RosterCreatedBy", fields: [createdById], references: [id])
  updatedById   Int?
  updatedBy     User?     @relation("RosterUpdatedBy", fields: [updatedById], references: [id])
  assignments   DutyScheduleAssignment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([departmentId, startDate, endDate])
  @@index([status])
}

model DutyScheduleAssignment {
  id             Int          @id @default(autoincrement())
  rosterId       Int
  roster         Roster       @relation(fields: [rosterId], references: [id])
  employeeId     Int
  employee       Employee     @relation(fields: [employeeId], references: [id])
  dutyScheduleId Int?
  dutySchedule   DutySchedule? @relation(fields: [dutyScheduleId], references: [id])
  departmentId   Int
  department     Department   @relation(fields: [departmentId], references: [id])
  date           DateTime
  status         String       @default("Scheduled") // "Scheduled" | "CheckedIn" | "Completed" | "OnLeave" | "Incomplete" | "Cancelled"
  comment        String?
  isLeave        Boolean      @default(false)
  isHoliday      Boolean      @default(false)
  isWeekend      Boolean      @default(false)
  changeRequest  String?
  createdById    Int
  createdBy      User         @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  updatedById    Int?
  updatedBy      User?        @relation("AssignmentUpdatedBy", fields: [updatedById], references: [id])
  attendance     Attendance?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([employeeId, date])
  @@index([rosterId])
  @@index([departmentId, date])
  @@index([dutyScheduleId])
}

model AttendanceSettings {
  id                  Int      @id @default(autoincrement())
  pressAndHoldEnabled Boolean  @default(true)
  updatedById         Int?
  updatedBy           User?    @relation("AttendanceSettingsUpdatedBy", fields: [updatedById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// GeneralSettings is a tenant-wide singleton (branding, locale, formatting), following
// the same get-or-create pattern as AttendanceSettings.
model GeneralSettings {
  id            Int      @id @default(autoincrement())
  siteTitle     String   @default("HRM Plus")
  logoUrl       String?
  logoKey       String?
  faviconUrl    String?
  faviconKey    String?
  dateFormat    String   @default("DD/MM/YYYY")
  timeFormat    String   @default("24h")
  timezone      String   @default("UTC")
  currency      String   @default("USD")
  language      String   @default("en")
  copyrightText String?
  updatedById   Int?
  updatedBy     User?    @relation("GeneralSettingsUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmployeeAttendanceMethod {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  method     String // "PressAndHold"
  createdAt  DateTime @default(now())

  @@unique([employeeId, method])
  @@index([employeeId])
}

model Attendance {
  id                       Int                    @id @default(autoincrement())
  employeeId               Int
  employee                 Employee               @relation(fields: [employeeId], references: [id])
  dutyScheduleAssignmentId Int                     @unique
  dutyScheduleAssignment   DutyScheduleAssignment  @relation(fields: [dutyScheduleAssignmentId], references: [id])
  date                     DateTime
  checkInAt                DateTime?
  checkInMethod            String?
  isLate                   Boolean                @default(false)
  lateReason               String?
  checkOutAt               DateTime?
  checkOutMethod           String?
  isEarlyCheckout          Boolean                @default(false)
  earlyCheckoutReason      String?
  isManualEntry            Boolean                @default(false)
  manualEntryById          Int?
  manualEntryBy            User?                  @relation("AttendanceManualEntryBy", fields: [manualEntryById], references: [id])
  manualEntryNote          String?
  breaks                   BreakLog[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([employeeId, date])
}

model BreakLog {
  id           Int        @id @default(autoincrement())
  attendanceId Int
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
  startAt      DateTime
  endAt        DateTime?
  isAutomatic  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([attendanceId])
}

model AttendanceIpRule {
  id            Int      @id @default(autoincrement())
  label         String
  cidr          String
  status        String   @default("Active")
  employeeRules EmployeeAttendanceIpRule[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AttendanceLocation {
  id            Int      @id @default(autoincrement())
  name          String
  latitude      Float
  longitude     Float
  radiusMeters  Int
  status        String   @default("Active")
  employeeRules EmployeeAttendanceLocation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmployeeAttendanceIpRule {
  id         Int              @id @default(autoincrement())
  employeeId Int
  employee   Employee         @relation(fields: [employeeId], references: [id])
  ipRuleId   Int
  ipRule     AttendanceIpRule @relation(fields: [ipRuleId], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([employeeId, ipRuleId])
  @@index([employeeId])
}

model EmployeeAttendanceLocation {
  id         Int                @id @default(autoincrement())
  employeeId Int
  employee   Employee           @relation(fields: [employeeId], references: [id])
  locationId Int
  location   AttendanceLocation @relation(fields: [locationId], references: [id])
  createdAt  DateTime           @default(now())

  @@unique([employeeId, locationId])
  @@index([employeeId])
}

model EmployeeAttendanceDevice {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id])
  deviceToken  String    @unique
  label        String?
  status       String    @default("Pending") // "Pending" | "Approved" | "Rejected"
  lastSeenAt   DateTime?
  lastSeenIp   String?
  requestedAt  DateTime  @default(now())
  approvedAt   DateTime?
  approvedById Int?
  approvedBy   User?     @relation("AttendanceDeviceApprovedBy", fields: [approvedById], references: [id])

  @@index([employeeId])
}

model EmployeeAttendanceRules {
  id                     Int      @id @default(autoincrement())
  employeeId             Int      @unique
  employee               Employee @relation(fields: [employeeId], references: [id])
  ipBindingEnabled       Boolean  @default(false)
  locationBindingEnabled Boolean  @default(false)
  deviceBindingEnabled   Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmployeeLeaveAllocation {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId   Int
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  year          Int
  allocatedDays Int
  daysUsed      Int      @default(0)
  status        String   @default("Active") // "Active" | "Inactive"
  approvalSteps LeaveApprovalStep[]
  leaveRequests LeaveRequest[]
  createdById   Int
  createdBy     User      @relation("LeaveAllocationCreatedBy", fields: [createdById], references: [id])
  updatedById   Int?
  updatedBy     User?     @relation("LeaveAllocationUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model LeaveApprovalStep {
  id           Int      @id @default(autoincrement())
  allocationId Int
  allocation   EmployeeLeaveAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  stepOrder    Int
  approverType String   // "ReportingManager" | "Role"
  roleId       Int?
  role         Role?    @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([allocationId, stepOrder])
  @@index([allocationId])
}

model LeaveRequest {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  employee         Employee @relation(fields: [employeeId], references: [id])
  allocationId     Int
  allocation       EmployeeLeaveAllocation @relation(fields: [allocationId], references: [id])
  startDate        DateTime
  endDate          DateTime
  daysRequested    Int
  reason           String?
  status           String   @default("Pending") // "Pending" | "Approved" | "Rejected" | "Cancelled"
  currentStepOrder Int      @default(1)
  approvals        LeaveRequestApproval[]
  createdById      Int
  createdBy        User     @relation("LeaveRequestCreatedBy", fields: [createdById], references: [id])
  updatedById      Int?
  updatedBy        User?    @relation("LeaveRequestUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([employeeId])
  @@index([allocationId])
  @@index([status])
}

model LeaveRequestApproval {
  id              Int      @id @default(autoincrement())
  leaveRequestId  Int
  leaveRequest    LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  stepOrder       Int
  approverType    String   // snapshot of the step's type at submission time
  roleId          Int?
  roleName        String?  // snapshot label, survives later role rename/deletion
  status          String   @default("Pending") // "Pending" | "Approved" | "Rejected"
  decidedByUserId Int?
  decidedBy       User?    @relation("LeaveApprovalDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([leaveRequestId, stepOrder])
  @@index([leaveRequestId])
}

model Holiday {
  id            Int       @id @default(autoincrement())
  name          String
  date          DateTime
  year          Int
  source        String    @default("Manual") // "Manual" | "NZ" | "AU"
  status        String    @default("Draft")  // "Draft" | "Published"
  notes         String?
  createdById   Int
  createdBy     User      @relation("HolidayCreatedBy", fields: [createdById], references: [id])
  updatedById   Int?
  updatedBy     User?     @relation("HolidayUpdatedBy", fields: [updatedById], references: [id])
  publishedById Int?
  publishedBy   User?     @relation("HolidayPublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([date])
  @@index([year])
  @@index([status])
}

model DocumentCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique // "SALARY_CERT" | "PAYSLIP" | "EXP_LETTER" | "APPOINT_LETTER" |
                              // "LEAVE_APPROVAL" | "APPRECIATION_LETTER" | "SALARY_INCREMENT" | "AWARD_LETTER"
  name      String
  status    String   @default("Active") // "Active" | "Inactive"
  templates DocumentTemplate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentTemplate {
  id                 Int      @id @default(autoincrement())
  shortCode          String   @unique
  name               String
  categoryId         Int
  category           DocumentCategory @relation(fields: [categoryId], references: [id])
  bodyHtml           String   @db.Text // HTML/CSS with {{placeholder}} and {{signature:Role}} tokens
  isStaffRequestable Boolean  @default(false)
  status             String   @default("Active") // "Active" | "Inactive"
  approvalSteps      DocumentTemplateApprovalStep[]
  requests           DocumentRequest[]
  createdById        Int
  createdBy          User     @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id])
  updatedById        Int?
  updatedBy          User?    @relation("DocumentTemplateUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([categoryId])
}

model DocumentTemplateApprovalStep {
  id           Int      @id @default(autoincrement())
  templateId   Int
  template     DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepOrder    Int
  approverType String   // "ReportingManager" | "Role"
  roleId       Int?
  role         Role?    @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([templateId, stepOrder])
  @@index([templateId])
}

model DocumentRequest {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  employee          Employee @relation(fields: [employeeId], references: [id])
  templateId        Int
  template          DocumentTemplate @relation(fields: [templateId], references: [id])
  reason            String?
  priority          String   @default("Medium") // "Low" | "Medium" | "High" | "Urgent"
  deadlineDate      DateTime?
  attachmentFileUrl String?
  attachmentFileKey String?
  fieldValues       Json?    // generic per-template manual data (e.g. payslip basic/allowances/deductions/netPay)
  status            String   @default("Pending") // "Pending" | "Approved" | "Issued" | "Rejected" | "Cancelled"
  currentStepOrder  Int      @default(1)
  referenceNumber   String?  @unique // set at issuance, e.g. "DOC-9F3KQJ2X"
  finalFileUrl      String?
  finalFileKey      String?
  issuedAt          DateTime?
  approvals         DocumentRequestApproval[]
  createdById       Int
  createdBy         User     @relation("DocumentRequestCreatedBy", fields: [createdById], references: [id])
  updatedById       Int?
  updatedBy         User?    @relation("DocumentRequestUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([employeeId])
  @@index([templateId])
  @@index([status])
}

model DocumentRequestApproval {
  id                Int      @id @default(autoincrement())
  documentRequestId Int
  documentRequest   DocumentRequest @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  stepOrder         Int
  approverType      String   // snapshot of the step's type at submission time
  roleId            Int?
  roleName          String?  // snapshot label, survives later role rename/deletion
  status            String   @default("Pending") // "Pending" | "Approved" | "Rejected"
  decidedByUserId   Int?
  decidedBy         User?    @relation("DocumentApprovalDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt         DateTime?
  comment           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([documentRequestId, stepOrder])
  @@index([documentRequestId])
}
