generator client {
  provider = "prisma-client-js"
  output   = "../../generated/tenant"
}

datasource db {
  provider = "mysql"
  url      = env("TENANT_MIGRATION_DATABASE_URL")
}

model Role {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  status           String   @default("Active")
  shortDescription String?
  users            User[]
  leaveApprovalSteps LeaveApprovalStep[]
  documentTemplateApprovalSteps DocumentTemplateApprovalStep[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id                 Int        @id @default(autoincrement())
  email              String     @unique
  passwordHash       String
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  roleId             Int
  role         Role       @relation(fields: [roleId], references: [id])
  employee     Employee?
  auditLogs    AuditLog[]
  rostersGenerated   Roster[]                 @relation("RosterGeneratedBy")
  rostersApproved    Roster[]                 @relation("RosterApprovedBy")
  rostersCreated     Roster[]                 @relation("RosterCreatedBy")
  rostersUpdated     Roster[]                 @relation("RosterUpdatedBy")
  assignmentsCreated DutyScheduleAssignment[] @relation("AssignmentCreatedBy")
  assignmentsUpdated DutyScheduleAssignment[] @relation("AssignmentUpdatedBy")
  passwordResetTokens PasswordResetToken[]
  leaveAllocationsCreated EmployeeLeaveAllocation[] @relation("LeaveAllocationCreatedBy")
  leaveAllocationsUpdated EmployeeLeaveAllocation[] @relation("LeaveAllocationUpdatedBy")
  leaveRequestsCreated    LeaveRequest[]            @relation("LeaveRequestCreatedBy")
  leaveRequestsUpdated    LeaveRequest[]            @relation("LeaveRequestUpdatedBy")
  leaveApprovalsDecided   LeaveRequestApproval[]    @relation("LeaveApprovalDecidedBy")
  attendanceSettingsUpdated AttendanceSettings[]    @relation("AttendanceSettingsUpdatedBy")
  generalSettingsUpdated    GeneralSettings[]       @relation("GeneralSettingsUpdatedBy")
  attendanceDevicesApproved EmployeeAttendanceDevice[] @relation("AttendanceDeviceApprovedBy")
  attendanceManualEntries   Attendance[]               @relation("AttendanceManualEntryBy")
  holidaysCreated    Holiday[]                @relation("HolidayCreatedBy")
  holidaysUpdated    Holiday[]                @relation("HolidayUpdatedBy")
  holidaysPublished  Holiday[]                @relation("HolidayPublishedBy")
  documentTemplatesCreated DocumentTemplate[]       @relation("DocumentTemplateCreatedBy")
  documentTemplatesUpdated DocumentTemplate[]       @relation("DocumentTemplateUpdatedBy")
  documentRequestsCreated  DocumentRequest[]        @relation("DocumentRequestCreatedBy")
  documentRequestsUpdated  DocumentRequest[]        @relation("DocumentRequestUpdatedBy")
  documentApprovalsDecided DocumentRequestApproval[] @relation("DocumentApprovalDecidedBy")
  assetsCreated             Asset[]                   @relation("AssetCreatedBy")
  assetsUpdated             Asset[]                   @relation("AssetUpdatedBy")
  assetAssignmentsMade      AssetAssignment[]         @relation("AssetAssignedBy")
  assetAssignmentsReturnedTo AssetAssignment[]        @relation("AssetReturnedTo")
  jobsPosted                Job[]                     @relation("JobPostedBy")
  jobsUpdated               Job[]                     @relation("JobUpdatedBy")
  screeningQuestionsCreated ScreeningQuestion[]       @relation("ScreeningQuestionCreatedBy")
  applicationStagesMoved    ApplicationStageHistory[] @relation("ApplicationStageMovedBy")
  assessmentsCreated        Assessment[]              @relation("AssessmentCreatedBy")
  assessmentsUpdated        Assessment[]              @relation("AssessmentUpdatedBy")
  siteSettingsUpdated       SiteSetting[]             @relation("SiteSettingUpdatedBy")
  blogPostsCreated          BlogPost[]                @relation("BlogPostCreatedBy")
  blogPostsUpdated          BlogPost[]                @relation("BlogPostUpdatedBy")
  legalPagesUpdated         LegalPage[]               @relation("LegalPageUpdatedBy")
  signatureImageUrl  String?
  signatureImageKey  String?
  signatureUpdatedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Department {
  id                 Int          @id @default(autoincrement())
  name               String
  status             String       @default("Active")
  shortDescription   String?
  parentDepartmentId Int?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[] @relation("DepartmentHierarchy")
  employees          Employee[]
  rosters            Roster[]
  dutyAssignments    DutyScheduleAssignment[]
  jobs               Job[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Shift {
  id        Int      @id @default(autoincrement())
  name      String
  startTime String
  endTime   String
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeekDay {
  id        Int      @id @default(autoincrement())
  name      String
  isWeekend Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveType {
  id           Int      @id @default(autoincrement())
  name         String
  assignedDays Int
  status       String   @default("Active")
  allocations  EmployeeLeaveAllocation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Designation {
  id               Int        @id @default(autoincrement())
  name             String
  status           String     @default("Active")
  shortDescription String?
  employees        Employee[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Employee {
  id              Int          @id @default(autoincrement())
  employeeCode    String       @unique
  firstName       String
  lastName        String
  email           String       @unique
  phoneNumber     String?
  gender          String?
  dateOfBirth     DateTime?
  jobTitle        String?
  status          String       @default("Active")
  joiningDate     DateTime
  terminationDate DateTime?
  employmentType  String       @default("Full-Time")
  avatarUrl       String?
  avatarKey       String?
  departmentId    Int?
  department      Department?  @relation(fields: [departmentId], references: [id])
  designationId   Int?
  designation     Designation? @relation(fields: [designationId], references: [id])
  reportingToId   Int?
  reportingTo     Employee?    @relation("EmployeeHierarchy", fields: [reportingToId], references: [id])
  directReports   Employee[]   @relation("EmployeeHierarchy")
  userId          Int?         @unique
  user            User?        @relation(fields: [userId], references: [id])
  documents       EmployeeDocument[]
  dutyAssignments DutyScheduleAssignment[]
  leaveAllocations EmployeeLeaveAllocation[]
  leaveRequests    LeaveRequest[]
  attendances         Attendance[]
  attendanceMethods   EmployeeAttendanceMethod[]
  attendanceIpRules     EmployeeAttendanceIpRule[]
  attendanceLocations   EmployeeAttendanceLocation[]
  attendanceDevices     EmployeeAttendanceDevice[]
  attendanceRules       EmployeeAttendanceRules?
  documentRequests      DocumentRequest[]
  assetAssignments      AssetAssignment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model EmployeeDocument {
  id              Int       @id @default(autoincrement())
  employeeId      Int
  employee        Employee  @relation(fields: [employeeId], references: [id])
  documentName    String
  type            String
  startDate       DateTime?
  expiryDate      DateTime?
  documentFileUrl String?
  documentFileKey String?
  status          String    @default("Active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ── Asset & Fleet Tracking ───────────────────────────────────────────────

model Asset {
  id           Int      @id @default(autoincrement())
  assetTag     String   @unique // e.g. "AST-9F3KQJ2X", generated on create
  name         String
  category     String   // "Laptop" | "Mobile" | "Tool" | "OfficeEquipment" | "VehicleCar" | "VehicleVan" | "EmployerHousing" | "Other"
  status       String   @default("Available") // "Available" | "Assigned" | "InRepair" | "Retired" | "Disposed"
  serialNumber String?
  purchaseDate DateTime?
  purchaseCost Decimal? @db.Decimal(12, 2)
  supplier     String?
  notes        String?  @db.Text

  // Vehicle-specific (nullable; only meaningful when category is VehicleCar/VehicleVan)
  registrationNumber String?
  registrationExpiry DateTime? // AU rego
  wofCofExpiry       DateTime? // NZ Warrant of Fitness (car) / Certificate of Fitness (heavy vehicle)
  make               String?
  model              String?
  vin                String?

  // Tool/equipment-specific
  testAndTagExpiry DateTime? // AU electrical test-and-tag

  // Generic expiry (warranty, lease-return date, etc.), reused by the reminder job for any category
  warrantyExpiry DateTime?

  // Fringe Benefit Tax flagging — surfaces which assets need accountant attention,
  // does not compute FBT owed (depends on business-use % and AU/NZ-specific formulas).
  isFbtRelevant Boolean @default(false)
  fbtNotes      String? @db.Text

  currentAssignmentId Int?              @unique
  currentAssignment   AssetAssignment?  @relation("CurrentAssetAssignment", fields: [currentAssignmentId], references: [id])
  assignments         AssetAssignment[] @relation("AssetAssignments")
  reminderLogs        AssetReminderLog[]

  photoUrl String?
  photoKey String?

  createdById Int
  createdBy   User  @relation("AssetCreatedBy", fields: [createdById], references: [id])
  updatedById Int?
  updatedBy   User? @relation("AssetUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([isFbtRelevant])
}

model AssetAssignment {
  id         Int      @id @default(autoincrement())
  assetId    Int
  asset      Asset    @relation("AssetAssignments", fields: [assetId], references: [id])
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  assignedAt   DateTime @default(now())
  assignedById Int
  assignedBy   User     @relation("AssetAssignedBy", fields: [assignedById], references: [id])

  expectedReturnDate DateTime?
  returnedAt         DateTime?
  returnedToId       Int?
  returnedTo         User?     @relation("AssetReturnedTo", fields: [returnedToId], references: [id])

  conditionOnAssign String?
  conditionOnReturn String?

  // Links to the DocumentRequest used for digital sign-off. assignReceiptRequestId is
  // one-to-one (each assignment gets its own receipt acknowledgement). returnReceiptRequestId
  // is many-to-one — a single offboarding return checklist commonly covers several assets
  // returned by the same employee at once, so it is NOT unique here.
  assignReceiptRequestId Int?             @unique
  assignReceiptRequest   DocumentRequest? @relation("AssetAssignReceipt", fields: [assignReceiptRequestId], references: [id])
  returnReceiptRequestId Int?
  returnReceiptRequest   DocumentRequest? @relation("AssetReturnReceipt", fields: [returnReceiptRequestId], references: [id])

  currentFor Asset? @relation("CurrentAssetAssignment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([employeeId])
}

// Dedup log for the scheduled expiry-reminder job — one row per (asset, expiry field,
// reminder window) sent, so a daily job doesn't re-email the same 30-day/7-day warning.
model AssetReminderLog {
  id          Int      @id @default(autoincrement())
  assetId     Int
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  expiryField String   // "registrationExpiry" | "wofCofExpiry" | "testAndTagExpiry" | "warrantyExpiry"
  windowDays  Int      // 30 | 7
  sentAt      DateTime @default(now())

  @@unique([assetId, expiryField, windowDays])
  @@index([assetId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   Int?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model DutySchedule {
  id                        Int      @id @default(autoincrement())
  name                      String
  startTime                 String
  endTime                   String
  checkinConsiderMinutes    Int      @default(0)
  checkoutConsiderMinutes   Int      @default(0)
  maxOverTimeMinutes        Int      @default(0)
  earlyCheckinBufferMinutes Int      @default(0)
  isTardyApplicable         Boolean  @default(true)
  status                    String   @default("Active")
  shortDescription          String?
  assignments               DutyScheduleAssignment[]
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Roster {
  id            Int       @id @default(autoincrement())
  departmentId  Int
  department    Department @relation(fields: [departmentId], references: [id])
  periodType    String    // "Weekly" | "Fortnightly" | "Monthly"
  startDate     DateTime
  endDate       DateTime
  status        String    @default("Draft") // "Draft" | "Pending" | "Approved"
  generatedById Int?
  generatedBy   User?     @relation("RosterGeneratedBy", fields: [generatedById], references: [id])
  approvedById  Int?
  approvedBy    User?     @relation("RosterApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  createdById   Int
  createdBy     User      @relation("RosterCreatedBy", fields: [createdById], references: [id])
  updatedById   Int?
  updatedBy     User?     @relation("RosterUpdatedBy", fields: [updatedById], references: [id])
  assignments   DutyScheduleAssignment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([departmentId, startDate, endDate])
  @@index([status])
}

model DutyScheduleAssignment {
  id             Int          @id @default(autoincrement())
  rosterId       Int
  roster         Roster       @relation(fields: [rosterId], references: [id])
  employeeId     Int
  employee       Employee     @relation(fields: [employeeId], references: [id])
  dutyScheduleId Int?
  dutySchedule   DutySchedule? @relation(fields: [dutyScheduleId], references: [id])
  departmentId   Int
  department     Department   @relation(fields: [departmentId], references: [id])
  date           DateTime
  status         String       @default("Scheduled") // "Scheduled" | "CheckedIn" | "Completed" | "OnLeave" | "Incomplete" | "Cancelled"
  comment        String?
  isLeave        Boolean      @default(false)
  isHoliday      Boolean      @default(false)
  isWeekend      Boolean      @default(false)
  changeRequest  String?
  createdById    Int
  createdBy      User         @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  updatedById    Int?
  updatedBy      User?        @relation("AssignmentUpdatedBy", fields: [updatedById], references: [id])
  attendance     Attendance?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([employeeId, date])
  @@index([rosterId])
  @@index([departmentId, date])
  @@index([dutyScheduleId])
}

model AttendanceSettings {
  id                  Int      @id @default(autoincrement())
  pressAndHoldEnabled Boolean  @default(true)
  updatedById         Int?
  updatedBy           User?    @relation("AttendanceSettingsUpdatedBy", fields: [updatedById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// GeneralSettings is a tenant-wide singleton (branding, locale, formatting), following
// the same get-or-create pattern as AttendanceSettings.
model GeneralSettings {
  id            Int      @id @default(autoincrement())
  siteTitle     String   @default("HRM Plus")
  logoUrl       String?
  logoKey       String?
  faviconUrl    String?
  faviconKey    String?
  dateFormat    String   @default("DD/MM/YYYY")
  timeFormat    String   @default("24h")
  timezone      String   @default("UTC")
  currency      String   @default("USD")
  language      String   @default("en")
  copyrightText String?
  updatedById   Int?
  updatedBy     User?    @relation("GeneralSettingsUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmployeeAttendanceMethod {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  method     String // "PressAndHold"
  createdAt  DateTime @default(now())

  @@unique([employeeId, method])
  @@index([employeeId])
}

model Attendance {
  id                       Int                    @id @default(autoincrement())
  employeeId               Int
  employee                 Employee               @relation(fields: [employeeId], references: [id])
  dutyScheduleAssignmentId Int                     @unique
  dutyScheduleAssignment   DutyScheduleAssignment  @relation(fields: [dutyScheduleAssignmentId], references: [id])
  date                     DateTime
  checkInAt                DateTime?
  checkInMethod            String?
  isLate                   Boolean                @default(false)
  lateReason               String?
  checkOutAt               DateTime?
  checkOutMethod           String?
  isEarlyCheckout          Boolean                @default(false)
  earlyCheckoutReason      String?
  isManualEntry            Boolean                @default(false)
  manualEntryById          Int?
  manualEntryBy            User?                  @relation("AttendanceManualEntryBy", fields: [manualEntryById], references: [id])
  manualEntryNote          String?
  breaks                   BreakLog[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([employeeId, date])
}

model BreakLog {
  id           Int        @id @default(autoincrement())
  attendanceId Int
  attendance   Attendance @relation(fields: [attendanceId], references: [id])
  startAt      DateTime
  endAt        DateTime?
  isAutomatic  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([attendanceId])
}

model AttendanceIpRule {
  id            Int      @id @default(autoincrement())
  label         String
  cidr          String
  status        String   @default("Active")
  employeeRules EmployeeAttendanceIpRule[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AttendanceLocation {
  id            Int      @id @default(autoincrement())
  name          String
  latitude      Float
  longitude     Float
  radiusMeters  Int
  status        String   @default("Active")
  employeeRules EmployeeAttendanceLocation[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmployeeAttendanceIpRule {
  id         Int              @id @default(autoincrement())
  employeeId Int
  employee   Employee         @relation(fields: [employeeId], references: [id])
  ipRuleId   Int
  ipRule     AttendanceIpRule @relation(fields: [ipRuleId], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([employeeId, ipRuleId])
  @@index([employeeId])
}

model EmployeeAttendanceLocation {
  id         Int                @id @default(autoincrement())
  employeeId Int
  employee   Employee           @relation(fields: [employeeId], references: [id])
  locationId Int
  location   AttendanceLocation @relation(fields: [locationId], references: [id])
  createdAt  DateTime           @default(now())

  @@unique([employeeId, locationId])
  @@index([employeeId])
}

model EmployeeAttendanceDevice {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id])
  deviceToken  String    @unique
  label        String?
  status       String    @default("Pending") // "Pending" | "Approved" | "Rejected"
  lastSeenAt   DateTime?
  lastSeenIp   String?
  requestedAt  DateTime  @default(now())
  approvedAt   DateTime?
  approvedById Int?
  approvedBy   User?     @relation("AttendanceDeviceApprovedBy", fields: [approvedById], references: [id])

  @@index([employeeId])
}

model EmployeeAttendanceRules {
  id                     Int      @id @default(autoincrement())
  employeeId             Int      @unique
  employee               Employee @relation(fields: [employeeId], references: [id])
  ipBindingEnabled       Boolean  @default(false)
  locationBindingEnabled Boolean  @default(false)
  deviceBindingEnabled   Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmployeeLeaveAllocation {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId   Int
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  year          Int
  allocatedDays Int
  daysUsed      Int      @default(0)
  status        String   @default("Active") // "Active" | "Inactive"
  approvalSteps LeaveApprovalStep[]
  leaveRequests LeaveRequest[]
  createdById   Int
  createdBy     User      @relation("LeaveAllocationCreatedBy", fields: [createdById], references: [id])
  updatedById   Int?
  updatedBy     User?     @relation("LeaveAllocationUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model LeaveApprovalStep {
  id           Int      @id @default(autoincrement())
  allocationId Int
  allocation   EmployeeLeaveAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  stepOrder    Int
  approverType String   // "ReportingManager" | "Role"
  roleId       Int?
  role         Role?    @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([allocationId, stepOrder])
  @@index([allocationId])
}

model LeaveRequest {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  employee         Employee @relation(fields: [employeeId], references: [id])
  allocationId     Int
  allocation       EmployeeLeaveAllocation @relation(fields: [allocationId], references: [id])
  startDate        DateTime
  endDate          DateTime
  daysRequested    Int
  reason           String?
  status           String   @default("Pending") // "Pending" | "Approved" | "Rejected" | "Cancelled"
  currentStepOrder Int      @default(1)
  approvals        LeaveRequestApproval[]
  createdById      Int
  createdBy        User     @relation("LeaveRequestCreatedBy", fields: [createdById], references: [id])
  updatedById      Int?
  updatedBy        User?    @relation("LeaveRequestUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([employeeId])
  @@index([allocationId])
  @@index([status])
}

model LeaveRequestApproval {
  id              Int      @id @default(autoincrement())
  leaveRequestId  Int
  leaveRequest    LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  stepOrder       Int
  approverType    String   // snapshot of the step's type at submission time
  roleId          Int?
  roleName        String?  // snapshot label, survives later role rename/deletion
  status          String   @default("Pending") // "Pending" | "Approved" | "Rejected"
  decidedByUserId Int?
  decidedBy       User?    @relation("LeaveApprovalDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([leaveRequestId, stepOrder])
  @@index([leaveRequestId])
}

model Holiday {
  id            Int       @id @default(autoincrement())
  name          String
  date          DateTime
  year          Int
  source        String    @default("Manual") // "Manual" | "NZ" | "AU"
  status        String    @default("Draft")  // "Draft" | "Published"
  notes         String?
  createdById   Int
  createdBy     User      @relation("HolidayCreatedBy", fields: [createdById], references: [id])
  updatedById   Int?
  updatedBy     User?     @relation("HolidayUpdatedBy", fields: [updatedById], references: [id])
  publishedById Int?
  publishedBy   User?     @relation("HolidayPublishedBy", fields: [publishedById], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([date])
  @@index([year])
  @@index([status])
}

model DocumentCategory {
  id        Int      @id @default(autoincrement())
  code      String   @unique // "SALARY_CERT" | "PAYSLIP" | "EXP_LETTER" | "APPOINT_LETTER" |
                              // "LEAVE_APPROVAL" | "APPRECIATION_LETTER" | "SALARY_INCREMENT" | "AWARD_LETTER"
  name      String
  status    String   @default("Active") // "Active" | "Inactive"
  templates DocumentTemplate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentTemplate {
  id                 Int      @id @default(autoincrement())
  shortCode          String   @unique
  name               String
  categoryId         Int
  category           DocumentCategory @relation(fields: [categoryId], references: [id])
  bodyHtml           String   @db.Text // HTML/CSS with {{placeholder}} and {{signature:Role}} tokens
  isStaffRequestable Boolean  @default(false)
  status             String   @default("Active") // "Active" | "Inactive"
  approvalSteps      DocumentTemplateApprovalStep[]
  requests           DocumentRequest[]
  createdById        Int
  createdBy          User     @relation("DocumentTemplateCreatedBy", fields: [createdById], references: [id])
  updatedById        Int?
  updatedBy          User?    @relation("DocumentTemplateUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([categoryId])
}

model DocumentTemplateApprovalStep {
  id           Int      @id @default(autoincrement())
  templateId   Int
  template     DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepOrder    Int
  approverType String   // "ReportingManager" | "Role"
  roleId       Int?
  role         Role?    @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([templateId, stepOrder])
  @@index([templateId])
}

model DocumentRequest {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  employee          Employee @relation(fields: [employeeId], references: [id])
  templateId        Int
  template          DocumentTemplate @relation(fields: [templateId], references: [id])
  reason            String?
  priority          String   @default("Medium") // "Low" | "Medium" | "High" | "Urgent"
  deadlineDate      DateTime?
  attachmentFileUrl String?
  attachmentFileKey String?
  fieldValues       Json?    // generic per-template manual data (e.g. payslip basic/allowances/deductions/netPay)
  status            String   @default("Pending") // "Pending" | "Approved" | "Issued" | "Rejected" | "Cancelled"
  currentStepOrder  Int      @default(1)
  referenceNumber   String?  @unique // set at issuance, e.g. "DOC-9F3KQJ2X"
  finalFileUrl      String?
  finalFileKey      String?
  issuedAt          DateTime?
  approvals         DocumentRequestApproval[]
  createdById       Int
  createdBy         User     @relation("DocumentRequestCreatedBy", fields: [createdById], references: [id])
  updatedById       Int?
  updatedBy         User?    @relation("DocumentRequestUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assetAssignReceipt  AssetAssignment?  @relation("AssetAssignReceipt")
  assetReturnReceipts AssetAssignment[] @relation("AssetReturnReceipt")

  @@index([employeeId])
  @@index([templateId])
  @@index([status])
}

model DocumentRequestApproval {
  id                Int      @id @default(autoincrement())
  documentRequestId Int
  documentRequest   DocumentRequest @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  stepOrder         Int
  approverType      String   // snapshot of the step's type at submission time
  roleId            Int?
  roleName          String?  // snapshot label, survives later role rename/deletion
  status            String   @default("Pending") // "Pending" | "Approved" | "Rejected"
  decidedByUserId   Int?
  decidedBy         User?    @relation("DocumentApprovalDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt         DateTime?
  comment           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([documentRequestId, stepOrder])
  @@index([documentRequestId])
}

// ── Job Recruitment & ATS ────────────────────────────────────────────────

model Job {
  id                 Int      @id @default(autoincrement())
  title              String
  slug               String   @unique // slugify(title) + short nanoid suffix on collision
  vacancyCount       Int      @default(1)
  location           String?  // free-text city/region, or "Remote"
  skills             Json     // string[]
  minExperienceYears Int?
  maxExperienceYears Int?
  jobType            String   @default("FULL_TIME") // "FULL_TIME" | "PART_TIME" | "CONTRACT" | "INTERNSHIP" | "CASUAL"
  salaryType         String   @default("ANNUAL")     // "HOURLY" | "ANNUAL"
  salaryMin          Float?
  salaryMax          Float?
  description        String   @db.Text
  status             String   @default("Draft") // "Draft" | "Open" | "Closed" | "Archived"
  departmentId       Int?
  department         Department? @relation(fields: [departmentId], references: [id])
  closesAt           DateTime?
  postedById         Int
  postedBy           User     @relation("JobPostedBy", fields: [postedById], references: [id])
  updatedById        Int?
  updatedBy          User?    @relation("JobUpdatedBy", fields: [updatedById], references: [id])
  screeningQuestions JobScreeningQuestion[]
  applications       Application[]
  assessment         Assessment?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([departmentId])
}

model ScreeningQuestion {
  id          Int      @id @default(autoincrement())
  code        String?  @unique // set only for system-seeded questions, e.g. "NZ_CRIMINAL_RECORD_CLEAN_SLATE"; null for tenant-authored
  text        String   @db.Text
  type        String   @default("SHORT_TEXT") // "YES_NO" | "SINGLE_CHOICE" | "MULTIPLE_CHOICE" | "SHORT_TEXT"
  options     Json?    // string[] — SINGLE_CHOICE / MULTIPLE_CHOICE only
  category    String   @default("Custom") // "LegalCompliance" | "Custom"
  isSystem    Boolean  @default(false) // seeded; blocks deletion via API, still editable
  status      String   @default("Active") // "Active" | "Inactive"
  jobLinks    JobScreeningQuestion[]
  createdById Int?
  createdBy   User?    @relation("ScreeningQuestionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model JobScreeningQuestion {
  id          Int      @id @default(autoincrement())
  jobId       Int
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  questionId  Int
  question    ScreeningQuestion @relation(fields: [questionId], references: [id])
  isMandatory Boolean  @default(true)
  sortOrder   Int      @default(0)
  answers     ApplicationAnswer[]
  createdAt   DateTime @default(now())

  @@unique([jobId, questionId])
  @@index([jobId])
  @@index([questionId])
}

model Candidate {
  id           Int      @id @default(autoincrement())
  fullName     String
  email        String   @unique
  phoneNumber  String?
  applications Application[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Application {
  id                   Int      @id @default(autoincrement())
  jobId                Int
  job                  Job      @relation(fields: [jobId], references: [id])
  candidateId          Int
  candidate            Candidate @relation(fields: [candidateId], references: [id])
  resumeFileUrl        String?
  resumeFileKey        String?
  coverLetter          String?  @db.Text
  stage                String   @default("APPLICATION_RECEIVED")
  // "APPLICATION_RECEIVED" | "AI_ASSESSMENT" | "VIRTUAL_INTERVIEW" | "IN_PERSON_INTERVIEW" | "OFFER" | "HIRED" | "REJECTED"
  movedToStageAt       DateTime @default(now())
  rejectionReason      String?
  withdrawnAt          DateTime?
  answers              ApplicationAnswer[]
  stageHistory         ApplicationStageHistory[]
  assessmentInvitation AssessmentInvitation?
  accessTokens         CandidateAccessToken[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([jobId, candidateId])
  @@index([jobId, stage])
  @@index([candidateId])
}

model ApplicationAnswer {
  id                     Int      @id @default(autoincrement())
  applicationId          Int
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobScreeningQuestionId Int
  jobScreeningQuestion   JobScreeningQuestion @relation(fields: [jobScreeningQuestionId], references: [id])
  answerText             String?  @db.Text   // YES_NO ("Yes"/"No") and SHORT_TEXT
  answerOptions          Json?               // string[] for SINGLE_CHOICE / MULTIPLE_CHOICE
  createdAt              DateTime @default(now())

  @@unique([applicationId, jobScreeningQuestionId])
  @@index([applicationId])
}

model ApplicationStageHistory {
  id            Int      @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     String?
  toStage       String
  movedByType   String   @default("User") // "User" | "System" — System = auto-transition from grading worker
  movedById     Int?
  movedBy       User?    @relation("ApplicationStageMovedBy", fields: [movedById], references: [id])
  note          String?
  createdAt     DateTime @default(now())

  @@index([applicationId])
}

model CandidateAccessToken {
  id            Int       @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  token         String    @unique // crypto.randomBytes(32).toString("hex"), same as PasswordResetToken
  purpose       String    @default("PORTAL") // "PORTAL" | "ASSESSMENT_INVITE" — informational only, both redeem identically
  expiresAt     DateTime
  lastUsedAt    DateTime? // updated on each redemption; multi-use until expiresAt
  createdAt     DateTime  @default(now())

  @@index([applicationId])
}

model Assessment {
  id                   Int      @id @default(autoincrement())
  jobId                Int      @unique
  job                  Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title                String   @default("Assessment")
  instructions         String?  @db.Text
  passThresholdPercent Int      @default(60)
  generationSource     String   @default("MANUAL") // "MANUAL" | "AI_GENERATED" | "AI_GENERATED_EDITED"
  status               String   @default("Draft") // "Draft" | "Published"
  questions            AssessmentQuestion[]
  invitations          AssessmentInvitation[]
  createdById          Int
  createdBy            User     @relation("AssessmentCreatedBy", fields: [createdById], references: [id])
  updatedById          Int?
  updatedBy            User?    @relation("AssessmentUpdatedBy", fields: [updatedById], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AssessmentQuestion {
  id                 Int      @id @default(autoincrement())
  assessmentId       Int
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type               String   @default("MCQ") // "MCQ" | "TRUE_FALSE" | "MULTIPLE_SELECT" | "SHORT_TEXT"
  prompt             String   @db.Text
  options            Json?    // string[] — MCQ | TRUE_FALSE | MULTIPLE_SELECT
  correctOptionIndex Int?     // MCQ | TRUE_FALSE — single correct option
  correctOptionIndexes Json?  // number[] — MULTIPLE_SELECT only
  points             Int      @default(1)
  sortOrder          Int      @default(0)
  answers            AssessmentAnswer[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([assessmentId])
}

model AssessmentInvitation {
  id            Int       @id @default(autoincrement())
  applicationId Int       @unique // one attempt per application
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assessmentId  Int
  assessment    Assessment @relation(fields: [assessmentId], references: [id])
  status        String    @default("INVITED") // "INVITED" | "IN_PROGRESS" | "SUBMITTED" | "GRADING" | "GRADED"
  totalPoints   Int?
  scoredPoints  Float?
  scorePercent  Float?
  outcome       String?   // "PASSED" | "PASSED_PENDING_REVIEW" | "FAILED" | null
  invitedAt     DateTime  @default(now())
  startedAt     DateTime?
  submittedAt   DateTime?
  gradedAt      DateTime?
  answers       AssessmentAnswer[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([assessmentId])
}

model AssessmentAnswer {
  id                  Int      @id @default(autoincrement())
  invitationId        Int
  invitation          AssessmentInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  questionId          Int
  question            AssessmentQuestion @relation(fields: [questionId], references: [id])
  selectedOptionIndex Int?     // MCQ | TRUE_FALSE
  selectedOptionIndexes Json?  // number[] — MULTIPLE_SELECT only
  textAnswer          String?  @db.Text // SHORT_TEXT
  isCorrect           Boolean? // MCQ | TRUE_FALSE | MULTIPLE_SELECT, computed instantly
  pointsAwarded       Float?
  gradingStatus       String   @default("PENDING") // "PENDING" | "INSTANT" | "QUEUED" | "GRADED" | "FAILED"
  aiFeedback          String?  @db.Text
  aiRawResponse        Json?
  gradedAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([invitationId, questionId])
  @@index([invitationId])
}

// ── Public Website CMS ──────────────────────────────────────────────────

model SiteSetting {
  id               Int      @id @default(autoincrement())
  siteTitle        String   @default("Our Company")
  tagline          String?
  logoUrl          String?
  logoKey          String?
  faviconUrl       String?
  faviconKey       String?
  primaryColor     String   @default("#4F46E5")
  secondaryColor   String   @default("#0EA5E9")
  contactEmail     String?
  contactPhone     String?
  contactAddress   String?  @db.Text
  businessHours    Json?    // { day: string; openTime: string; closeTime: string; isClosed: boolean }[]
  aboutHeading     String?
  aboutContent     String?  @db.Text // fills the "about" SiteSection — no dedicated About model
  metaDescription  String?  @db.Text
  updatedById      Int?
  updatedBy        User?    @relation("SiteSettingUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SiteSection {
  id          Int      @id @default(autoincrement())
  sectionKey  String   @unique // "hero" | "about" | "overview" | "gallery" | "careers" | "blogs" | "contact"
  displayName String
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model HeroSlide {
  id               Int      @id @default(autoincrement())
  headline         String
  subHeadline      String?
  mediaType        String   @default("IMAGE") // "IMAGE" | "VIDEO"
  mediaUrl         String
  mediaKey         String?
  ctaPrimaryText   String?
  ctaPrimaryUrl    String?
  ctaSecondaryText String?
  ctaSecondaryUrl  String?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model CompanyService {
  id          Int      @id @default(autoincrement())
  icon        String   // lucide-react icon name, e.g. "Rocket"
  title       String
  summary     String
  description String   @db.Text // HTML
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model GalleryItem {
  id           Int      @id @default(autoincrement())
  title        String?
  caption      String?
  category     String?
  imageUrl     String
  imageKey     String?
  thumbnailUrl String?
  thumbnailKey String?
  isFeatured   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([sortOrder])
}

model BlogPost {
  id               Int       @id @default(autoincrement())
  title            String
  slug             String    @unique // slugify(title) + short nanoid suffix on collision
  featuredImageUrl String?
  featuredImageKey String?
  excerpt          String?   @db.Text
  content          String    @db.Text // rich HTML from Tiptap, trusted admin content — not sanitized
  authorName       String?
  authorAvatarUrl  String?
  status           String    @default("DRAFT") // "DRAFT" | "PUBLISHED"
  publishedAt      DateTime?
  createdById      Int
  createdBy        User      @relation("BlogPostCreatedBy", fields: [createdById], references: [id])
  updatedById      Int?
  updatedBy        User?     @relation("BlogPostUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  status    String   @default("UNREAD") // "UNREAD" | "READ" | "ARCHIVED"
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SocialLink {
  id        Int      @id @default(autoincrement())
  platform  String   // e.g. "Facebook" | "LinkedIn" | "Twitter" | "Instagram" | "YouTube"
  icon      String   // lucide-react icon name
  url       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model LegalPage {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // admin-set, e.g. "privacy-policy" | "terms-of-service" — not auto-slugified
  title       String
  content     String   @db.Text // rich HTML from Tiptap, trusted — not sanitized
  updatedById Int?
  updatedBy   User?    @relation("LegalPageUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
