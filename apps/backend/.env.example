# Control-plane database (tenant registry)
CONTROL_DATABASE_URL="mysql://root@localhost:3306/hrm_control"

# Used only when authoring tenant migrations (prisma migrate dev --schema=prisma/tenant/schema.prisma).
# Points at a scratch/template database, never a real tenant's data.
TENANT_MIGRATION_DATABASE_URL="mysql://root@localhost:3306/hrm_tenant_template"

# Base connection info used to build each tenant's DATABASE_URL at runtime (host/port/credentials only;
# the database name itself comes from Tenant.databaseName in the control DB).
TENANT_DB_HOST="localhost"
TENANT_DB_PORT="3306"
TENANT_DB_USER="root"
TENANT_DB_PASSWORD=""

JWT_ACCESS_SECRET="change-me-dev-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-dev-refresh-secret"
JWT_REFRESH_TTL="7d"

PORT="4000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
