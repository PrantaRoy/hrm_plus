{
  "info": {
    "_postman_id": "7d1ab0e2-213c-4f5a-aa59-d3a6e948b517",
    "name": "HRM PLUS API",
    "description": "All backend API endpoints implemented so far for HRM PLUS. One Express backend serves two route namespaces: /api/* (tenant-scoped, consumed by the tenant employee portal) and /saas/* (consumed by the public SaaS landing/signup pages and the super-admin portal). Folders below group requests by which side of the system they belong to.\n\nRun requests top-to-bottom within a folder the first time — login/create requests have test scripts that auto-save tokens and ids (tenantAccessToken, saasAccessToken, employeeId, departmentId, packageId, applicationId, saasTenantId) into collection variables so later requests work without manual copy-pasting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "tenantSlug", "value": "acme", "type": "string" },
    { "key": "tenantEmail", "value": "admin@acme.hrmplus.test", "type": "string" },
    { "key": "tenantPassword", "value": "PUxoBkUueckZ", "type": "string" },
    { "key": "tenantAccessToken", "value": "", "type": "string" },
    { "key": "tenantMustChangePassword", "value": "", "type": "string" },
    { "key": "employeeId", "value": "", "type": "string" },
    { "key": "departmentId", "value": "", "type": "string" },
    { "key": "saasAdminEmail", "value": "owner@hrmplus.test", "type": "string" },
    { "key": "saasAdminPassword", "value": "SuperAdmin123!", "type": "string" },
    { "key": "saasAccessToken", "value": "", "type": "string" },
    { "key": "packageId", "value": "", "type": "string" },
    { "key": "applicationId", "value": "", "type": "string" },
    { "key": "saasTenantId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Basic liveness check, no auth required."
      },
      "response": []
    },
    {
      "name": "Tenant Backend",
      "description": "Protected tenant-data endpoints (employee directory, departments). Every request needs X-Tenant-Slug and a tenant access token from Tenant Frontend > Login.",
      "item": [
        {
          "name": "Employees",
          "item": [
            {
              "name": "List Employees",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" }
                ],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{tenantAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/employees?page=1&pageSize=20&search=&departmentId=",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "employees"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "pageSize", "value": "20" },
                    { "key": "search", "value": "", "disabled": true },
                    { "key": "departmentId", "value": "", "disabled": true }
                  ]
                },
                "description": "Paginated, searchable, department-filterable employee list."
              },
              "response": []
            },
            {
              "name": "Get Employee",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" }
                ],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{tenantAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "employees", "{{employeeId}}"]
                }
              },
              "response": []
            },
            {
              "name": "Create Employee",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const json = pm.response.json();",
                      "  pm.collectionVariables.set('employeeId', json.id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{tenantAccessToken}}", "type": "string" }]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane.doe.{{$timestamp}}@acme.test\",\n  \"jobTitle\": \"Software Engineer\",\n  \"startDate\": \"2026-02-01\",\n  \"departmentId\": null,\n  \"managerId\": null,\n  \"role\": \"Staff\",\n  \"password\": \"SuperSecret123!\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/employees",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "employees"]
                },
                "description": "Requires Admin or HR role. Creates a linked login User + Employee record. Saves the new id into {{employeeId}}."
              },
              "response": []
            },
            {
              "name": "Update Employee",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{tenantAccessToken}}", "type": "string" }]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"jobTitle\": \"Senior Software Engineer\",\n  \"status\": \"Active\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "employees", "{{employeeId}}"]
                },
                "description": "Requires Admin, HR, or Manager role. All fields optional: firstName, lastName, jobTitle, departmentId, managerId, status (Active/Inactive)."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Departments",
          "item": [
            {
              "name": "List Departments",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" }
                ],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{tenantAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/api/departments",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "departments"]
                }
              },
              "response": []
            },
            {
              "name": "Create Department",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const json = pm.response.json();",
                      "  pm.collectionVariables.set('departmentId', json.id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{tenantAccessToken}}", "type": "string" }]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Engineering\",\n  \"parentDepartmentId\": null\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/departments",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "departments"]
                },
                "description": "Requires Admin or HR role. Saves the new id into {{departmentId}}."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Tenant Frontend",
      "description": "Auth flow used directly by the tenant login screen: two-step email/password login, session check, and forced password change.",
      "item": [
        {
          "name": "Check Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenantEmail}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/check-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "check-email"]
            },
            "description": "Step 1 of login: returns { exists: boolean }. The password field is only shown client-side once this returns true."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('tenantAccessToken', json.accessToken);",
                  "  pm.collectionVariables.set('tenantMustChangePassword', json.mustChangePassword);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenantEmail}}\",\n  \"password\": \"{{tenantPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Step 2 of login. Response includes mustChangePassword — if true, the frontend forces a password change before showing the dashboard. Saves accessToken into {{tenantAccessToken}}."
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tenantAccessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Tenant-Slug", "value": "{{tenantSlug}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{tenantAccessToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{tenantPassword}}\",\n  \"newPassword\": \"NewPassword123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "change-password"]
            },
            "description": "Sets a new password and clears mustChangePassword. Returns 204 with no body."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Saas Backend",
      "description": "Protected super-admin portal endpoints. Every request (except Saas Admin Login) needs a saas-admin access token from Saas Backend > Auth > Saas Admin Login.",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Saas Admin Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const json = pm.response.json();",
                      "  pm.collectionVariables.set('saasAccessToken', json.accessToken);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{saasAdminEmail}}\",\n  \"password\": \"{{saasAdminPassword}}\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "auth", "login"]
                },
                "description": "Signed with a separate secret (JWT_SAAS_ACCESS_SECRET) from tenant tokens. Saves accessToken into {{saasAccessToken}}."
              },
              "response": []
            },
            {
              "name": "Saas Admin Me",
              "request": {
                "method": "GET",
                "header": [],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/auth/me",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "auth", "me"]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "Packages (Admin)",
          "item": [
            {
              "name": "List Packages (Admin)",
              "request": {
                "method": "GET",
                "header": [],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/packages",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "packages"]
                },
                "description": "Includes inactive packages, unlike the public listing."
              },
              "response": []
            },
            {
              "name": "Create Package",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "  const json = pm.response.json();",
                      "  pm.collectionVariables.set('packageId', json.id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Growth\",\n  \"price\": 49.99,\n  \"validityDays\": 30,\n  \"isActive\": true\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/packages",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "packages"]
                },
                "description": "price: 0 = free. validityDays: null = unlimited. Saves the new id into {{packageId}}."
              },
              "response": []
            },
            {
              "name": "Update Package",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Growth (Updated)\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/packages/{{packageId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "packages", "{{packageId}}"]
                },
                "description": "All fields optional: name, price, validityDays, isActive. Body here only renames it (deliberately does not set isActive:false, since {{packageId}} is likely still referenced by Saas Frontend > Submit Application below)."
              },
              "response": []
            },
            {
              "name": "Delete Package",
              "request": {
                "method": "DELETE",
                "header": [],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/packages/{{packageId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "packages", "{{packageId}}"]
                },
                "description": "Run this LAST, after the Applications/Tenants requests below. Expected to return 409 once a tenant is on this package — that's the intended protection, demonstrating a package in use cannot be deleted. Run against a freshly-created, unused package to see the 204 success path instead."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Applications (Admin)",
          "description": "These read/act on {{applicationId}}, which is only set after running Saas Frontend > Submit Application at least once. Run that first, then come back to Get/Update/Approve/Reject here.",
          "item": [
            {
              "name": "List Applications",
              "request": {
                "method": "GET",
                "header": [],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/applications?status=Pending",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "applications"],
                  "query": [{ "key": "status", "value": "Pending", "description": "Pending | Approved | Rejected, omit for all" }]
                }
              },
              "response": []
            },
            {
              "name": "Get Application",
              "request": {
                "method": "GET",
                "header": [],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/applications/{{applicationId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "applications", "{{applicationId}}"]
                }
              },
              "response": []
            },
            {
              "name": "Update Application",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"companyName\": \"Acme Ltd (Edited)\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/applications/{{applicationId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "applications", "{{applicationId}}"]
                },
                "description": "Only allowed while the application is still Pending. All fields optional: companyName, companyType, overview, numberOfEmployees, contactEmail, packageId."
              },
              "response": []
            },
            {
              "name": "Approve Application",
              "request": {
                "method": "POST",
                "header": [],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/applications/{{applicationId}}/approve",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "applications", "{{applicationId}}", "approve"]
                },
                "description": "Provisions a real tenant database, seeds roles, creates the tenant Admin user (password 12345678, mustChangePassword=true), and emails the login details."
              },
              "response": []
            },
            {
              "name": "Reject Application",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reviewNote\": \"Not a fit right now\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/applications/{{applicationId}}/reject",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "applications", "{{applicationId}}", "reject"]
                },
                "description": "reviewNote is optional. Note: if the application above was just approved, this will correctly return 409 (already Approved) — reject a different, still-Pending application to see the success path."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Tenants (Admin)",
          "description": "Update Tenant and Toggle Tenant Status act on {{saasTenantId}}, auto-captured by List Tenants below (run List Tenants at least once first — it grabs the newest tenant, which is the one Approve Application above just created).",
          "item": [
            {
              "name": "List Tenants",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const json = pm.response.json();",
                      "  if (Array.isArray(json) && json.length > 0) {",
                      "    pm.collectionVariables.set('saasTenantId', json[0].id);",
                      "  }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/tenants",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "tenants"]
                },
                "description": "Every provisioned company with package name, start/end date, and status. Ordered newest-first, so this saves the most recently created tenant's id into {{saasTenantId}} for the two requests below."
              },
              "response": []
            },
            {
              "name": "Update Tenant",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Acme Ltd (Updated)\"\n}",
                  "options": { "raw": { "language": "json" } }
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/tenants/{{saasTenantId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "tenants", "{{saasTenantId}}"]
                },
                "description": "All fields optional: name, companyType, overview, numberOfEmployees, contactEmail."
              },
              "response": []
            },
            {
              "name": "Toggle Tenant Status",
              "request": {
                "method": "POST",
                "header": [],
                "auth": {
                  "type": "bearer",
                  "bearer": [{ "key": "token", "value": "{{saasAccessToken}}", "type": "string" }]
                },
                "url": {
                  "raw": "{{baseUrl}}/saas/admin/tenants/{{saasTenantId}}/toggle-status",
                  "host": ["{{baseUrl}}"],
                  "path": ["saas", "admin", "tenants", "{{saasTenantId}}", "toggle-status"]
                },
